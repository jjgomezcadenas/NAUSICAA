## ----------------------------------------------------------------------------
## nexus | ItacaChamber.bi214.config.mac
##
## Template. The job script replaces @SEED@, @START_ID@ and @OUTPUT@.
## Gammas of the 2447.86 keV line of 214Bi, emitted isotropically from the inner
## surface of the gas cylinder. Events are saved when the energy deposited in
## the gas lies in the window below, as for the other samples.
## ----------------------------------------------------------------------------

/run/verbose 1
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

/control/execute macros/geometries/ItacaChamber.mac

/Generator/SingleParticle/particle gamma
/Generator/SingleParticle/min_energy 2447.86 keV
/Generator/SingleParticle/max_energy 2447.86 keV
/Generator/SingleParticle/region INNER_SURFACE

/Actions/DefaultEventAction/min_energy 2300 keV
/Actions/DefaultEventAction/max_energy 2470 keV

/nexus/random_seed @SEED@
/nexus/persistency/start_id @START_ID@
/nexus/persistency/output_file @OUTPUT@
/nexus/persistency/event_type background
